# ============================================
# Review Certs — Server Environment Variables
# ============================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control.

# ─── Server ─────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Database ───────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=CHANGE_ME
DB_NAME=review_certs

# ─── JWT Authentication ─────────────────────
# REQUIRED: Generate with `openssl rand -base64 48`
JWT_SECRET=CHANGE_ME_USE_RANDOM_64_CHAR_STRING
JWT_EXPIRES_IN=7d

# ─── Frontend URL (for OAuth redirects) ─────
FRONTEND_URL=http://localhost:5173

# ─── CORS (comma-separated origins) ────────
# CORS_ORIGINS=http://localhost:5173,http://localhost:4321

# ─── Rate Limiting (optional) ──────────────
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=100

# ─── OAuth: Google ──────────────────────────
# Get credentials at https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/social/google/callback

# ─── OAuth: Facebook ───────────────────────
# Get credentials at https://developers.facebook.com/apps
# FACEBOOK_CLIENT_ID=your-facebook-app-id
# FACEBOOK_CLIENT_SECRET=your-facebook-app-secret
# FACEBOOK_CALLBACK_URL=http://localhost:3000/api/auth/social/facebook/callback

# ─── OAuth: X (Twitter) ────────────────────
# Get credentials at https://developer.x.com/en/portal
# X_CLIENT_ID=your-x-client-id
# X_CLIENT_SECRET=your-x-client-secret
# X_CALLBACK_URL=http://localhost:3000/api/auth/social/x/callback
