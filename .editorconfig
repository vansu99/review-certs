# EditorConfig — consistent coding styles across IDEs
# https://editorconfig.org

root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false
max_line_length = 100

[*.sql]
indent_size = 2

[Dockerfile]
indent_size = 4

[Makefile]
indent_style = tab
