# ============================================
# Review Certs — Root .gitignore
# ============================================

# ─── Dependencies ───────────────────────────
node_modules/

# ─── Build Output ───────────────────────────
dist/
dist-ssr/
build/
*.tsbuildinfo

# ─── Environment Variables ──────────────────
.env
.env.local
.env.*.local
# Keep .env.example and .env.development (no secrets)
!.env.example
!.env.development

# ─── Logs ───────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── OS Files ───────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# ─── IDE / Editor ───────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# ─── Test & Coverage ───────────────────────
coverage/
.nyc_output/
*.lcov

# ─── Docker ─────────────────────────────────
# Don't ignore docker-compose.yml or Dockerfile
*.pid

# ─── Miscellaneous ──────────────────────────
.cache/
.temp/
.tmp/
*.local

# Agent skills
.agents/*
.github/*
.codex/*